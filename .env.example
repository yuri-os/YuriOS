# Build #5 config (SPEC §11 + §25). Copy to .env. Every knob has a default in
# world/config.py (which extends Build #2's desktop/config.py, which extends the
# Build #1 brain's app/config.py); this file shows the ones you'll actually touch.

# --- the brain (Build #1, reused) — see Build #2's .env.example for the full story
# The model id's PREFIX picks the provider: gguf/… | lm_studio/… | ollama/… |
# openrouter/… . The direct gguf/ route downloads its Q4_K_M GGUF from Hugging
# Face, proves its llama.cpp options in a sacrificial process, then runs the
# passing configuration in-process. It never needs LM Studio.
# An uncensored model on purpose — she's a companion, not an assistant, and a
# refusal-trained model plays her badly. Any LiteLLM route works instead.
#
# This is the HOUSE DEFAULT: every character inherits it unless her own record
# says otherwise. NONE deliberately makes no LLM connection. On first web load,
# or with `yurios configure`, choose a model; a gguf/ choice is downloaded on
# demand. The top panel of the gear can still give one character her own model.
CHAT_MODEL=NONE
UTILITY_MODEL=NONE
# The default Hugging Face choice resolves
# Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf. GGUF_REPO only
# overrides the repository when a serving/model id cannot name it directly.
GGUF_REPO=
GGUF_QUANT=Q4_K_M
GGUF_CACHE_DIR=./models
GGUF_CONTEXT_LENGTH=0              # 0 = CONTEXT_LENGTH, otherwise 8192; preflight can fall back to 8192
GGUF_N_GPU_LAYERS=0                # CPU wheel by default; partial GPU offload falls back to full GPU/CPU
GGUF_N_THREADS=0                   # llama.cpp chooses automatically
GGUF_FLASH_ATTN=true               # efficient long-context KV cache; required for Gemma 4
# The context window she runs in, in tokens. The direct GGUF provider passes this
# to llama.cpp unless GGUF_CONTEXT_LENGTH overrides it. Bigger costs RAM/VRAM for
# the KV cache — 8192 is a floor, 32768 is comfortable; your machine decides.
CONTEXT_LENGTH=32768
# Local Ollama server — routes ollama/… model ids and lets the settings panel
# list the models you've pulled.
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# Real-time voice: reply <think> OFF, utility <think> ON (B2 §2.5–§2.6).
CHAT_THINKING=false
UTILITY_THINKING=true
UTILITY_MAX_TOKENS=10048

# Embeddings stay local (B2 §2.4). Default: sentence_tf runs IN-PROCESS through the
# sentence-transformers package installed with YuriOS (weights pulled from HuggingFace
# once), so memory works without LM Studio or Ollama. To share LM Studio with the chat
# model instead, set EMBED_BACKEND=lm_studio, EMBED_MODEL=text-embedding-nomic-embed-
# text-v1.5, and EMBED_DIM=768. `ollama` is another local-server option.
#
# EMBED_MODEL and EMBED_DIM must match the backend (a mismatch fails at reindex).
# Changing any of the three re-indexes the Vault from its .md files automatically
# (fingerprint check, §2.4) — safe to switch later, it just costs one reindex.
EMBED_BACKEND=sentence_tf
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Her own Vault (standalone). Seed once: `python scripts/seed_vault.py`. Point at a
# Build #1/#2 Vault to *continue* that companion (SPEC §2.4) — she is the folder.
VAULT_DIR=./vault
SOUL_SRC=./soul-src
# YuriOS 0.2 copies the legacy roots above into a character-scoped data tree on
# first normal startup. The source directories remain untouched as a backup.
DATA_DIR=./data
UTILITY_ENABLED=true
DREAM_ENABLED=true

HOST=127.0.0.1
PORT=8768

# --- voice (vendored Build #2 stack; see its .env.example for every knob) -----
# `./install.sh` installs all three of these by default (CPU-only, no CUDA), so this
# file works as shipped. `./install.sh --thin` skips them and, for a newly created
# .env, sets the three knobs below to `fake` — she boots either way, a fake seam is
# just silent. Existing .env files are preserved.
STT_BACKEND=faster_whisper        # faster_whisper | fake
STT_MODEL=base.en
TTS_BACKEND=kokoro                # kokoro (default, CPU) | qwen3_tts | gpt_sovits | fake
VAD_BACKEND=silero                # silero | fake
MASK_LATENCY=true
MAX_REPLY_TOKENS=1600
# Her voice loads when someone enters one of her rooms (opens /ws/voice) and is freed
# when the last of them leaves, so a node hosting several characters keeps one voice
# resident instead of one per character. The grace period below covers a page reload.
VOICE_PRELOAD=false               # true = warm at boot instead (single-companion installs)
VOICE_UNLOAD_AFTER_S=60           # empty-room grace, seconds; 0 = at once, -1 = never unload

# --- the hands: tools over MCP (SPEC §7) --------------------------------------
# mcp = real in-repo MCP server over stdio (the default; needs the `mcp` package,
# installed with the build). fake = deterministic offline results. off = no hands.
TOOLS_BACKEND=mcp                 # mcp | fake | off
TOOL_MAX_CALLS_PER_TURN=2         # per-turn cap (§7.3)
TOOL_TIMEOUT_S=10                 # per-call timeout
TOOL_LOG_DIR=./tool-logs          # one JSONL audit line per call, allowed or denied
# Per-tool rate limits, calls per minute (token bucket, §7.3):
TOOL_RATE_TIMER=6
TOOL_RATE_MUSIC=6
TOOL_RATE_WEATHER=4
TIMER_MAX_MINUTES=180             # set_timer upper bound (§7.1)
WEATHER_BACKEND=open_meteo        # open_meteo (real lookup, keyless) | fake
WEATHER_CITY=Seoul                # default city when she isn't told one

# Her camera (§7.6): take_selfie (a photo of her) and show_picture (a photo of
# anything else — the street, a sketch, whatever she's describing) both render
# through the vendored forge (./forge).
# openrouter = hosted (needs OPENROUTER_API_KEY above; GPU stays free for her
# voice). diffusers = a local SDXL checkpoint on your own GPU (below). mock =
# placeholder cards, keyless. off = no camera. No key with openrouter set? She
# degrades to mock with one loud WARNING. New installs leave her camera off;
# configure it with `yurios configure --selfie-backend ...`.
SELFIE_BACKEND=off                # openrouter | diffusers | mock | off
SELFIE_MODEL=bytedance-seed/seedream-4.5
SELFIE_DIR=./selfies              # saved shots + their provenance ledger (/selfies/)
# Optional overlay yaml merged over the shipped selfie template library —
# your own scenes/moods/tiers, a file outside the repo like the checkpoint.
# SELFIE_TEMPLATES_EXTRA=./data/characters/yuri/selfie-extra.yaml
TOOL_RATE_SELFIE=2                # calls/minute — images are expensive
TOOL_RATE_PICTURE=2               # show_picture gets its own budget, not a share

# SELFIE_BACKEND=diffusers — her own camera, on your own GPU, no third party.
# The model is loaded IN-PROCESS with diffusers (no A1111/ComfyUI to install):
#
#   1. pip install -e ".[forge-local]"     # + torch with CUDA (the PyPI default)
#   2. Download an Illustrious-lineage SDXL checkpoint (.safetensors) from
#      Civitai — the reference pick is a Pie Model:
#        https://civitai.com/models/1593793/pie-models
#      (one base per aesthetic — Lemon = general anime, Nutella = sharp linework,
#      Blueberry = semi-realistic; any Illustrious-family base works, and swapping
#      models later is swapping this one path). ~7 GB; a free Civitai account may
#      be required; the model's own license applies. LoRA is NOT wired in this
#      build — base checkpoint only.
#   3. Point SELFIE_LOCAL_MODEL at the file and set SELFIE_BACKEND=diffusers.
#
# The shipped yuri.yaml already carries the booru-style quality preamble these
# bases expect — prompts need no changes. The defaults below are the Pie
# author's own (DPM++ 2M / Karras / 30 steps / CFG 5 / hires fix on). VRAM:
# ~7 GB fp16 next to your LLM's ~6.7 GB fits a 16 GB card; set
# SELFIE_LOCAL_CPU_OFFLOAD=true if you need the headroom (renders ~2× slower).
SELFIE_LOCAL_MODEL=               # path to the .safetensors checkpoint
SELFIE_LOCAL_DEVICE=cuda
SELFIE_LOCAL_STEPS=30
SELFIE_LOCAL_CFG=5.0
SELFIE_LOCAL_HIRES=true           # upscale 1.5x + low-denoise img2img pass
SELFIE_LOCAL_HIRES_SCALE=1.5
SELFIE_LOCAL_HIRES_DENOISE=0.35
SELFIE_LOCAL_CPU_OFFLOAD=false
# The HIRES_* knobs above are SDXL's second pass; Krea 2 renders at size in one.
#
# Krea 2 checkpoints: same knob, different architecture. If SELFIE_LOCAL_MODEL
# is a Krea 2 export rather than SDXL, SELFIE_BACKEND=diffusers notices (it
# reads the file's header) and loads it through the krea2 backend instead —
# nothing here to change. SELFIE_BACKEND=krea2 forces it, for a file whose
# header doesn't say. That path needs two extra things:
#
#   1. pip install -e ".[forge-krea2]"    # adds comfy-kitchen
#   2. HF access to the text encoder + VAE, which these single-file checkpoints
#      don't carry: accept the licence at https://huggingface.co/krea/Krea-2-Raw
#      while signed in, then `huggingface-cli login` (or set HF_TOKEN). Fetched
#      once and cached; its own transformer weights are skipped — yours replace
#      them. Without this she degrades to placeholder cards and says so.
#
# The weights are never dequantized: a Krea 2 transformer is ~12.5 B parameters
# (~23 GB at bf16, which fits nothing), so the INT4 file is run as-is at ~6.4 GB
# resident — smaller AND faster than unpacking it. Sampling differs from SDXL's,
# so it gets its own two knobs; 0 / -1 mean "read it off the checkpoint" —
# 8 steps at guidance 0.0 for a turbo/TDM export, 28 at 4.5 for a base one.
# Set them only to override that.
SELFIE_KREA2_STEPS=0
SELFIE_KREA2_CFG=-1
# VRAM lending: when a render is requested and the free VRAM won't hold the
# resident pipeline (~11 GiB) next to your LLM, the LLM is PARKED — unloaded
# for the render's duration, then brought back (the render drops from a ~70s
# offload crawl to ~15s resident). Works for LM Studio models (evicted over
# its API) and for the direct gguf/ route (llama.cpp contexts closed in-process
# and reloaded). Her brain always comes back, even if a render fails. Set false
# to never touch the LLM (renders use offload instead).
SELFIE_LLM_PARK=true

# --- the mind: the always-on tick loop (SPEC §15–§18) -----------------------------
MIND_ENABLED=true                 # off = Build #4 behaviour, minus the ambient life
MIND_SEED=0                       # 0 = unseeded; tests pin a seed for determinism
MIND_ACT_THRESHOLD=0.4            # gate 1: salience-to-act (most ticks REST below it)
MIND_INTERRUPT_THRESHOLD=0.75     # gate 2: salience-to-interrupt — YOUR dial (§18.2)
MIND_MAX_INTERRUPTS_PER_DAY=3     # the hard daily cap on her reaching out first
MIND_DAILY_TOKENS=200000          # the budget governor's cap (§17.3)
MIND_DREAM_TICK_TOKENS=40000      # per-DREAM-tick consolidation budget (§21)
MIND_ENGAGED_CADENCE_S=10         # tick cadence per activity state (§17.1)…
MIND_IDLE_CADENCE_S=60
MIND_DORMANT_CADENCE_S=900
MIND_DREAM_CADENCE_S=120
MIND_ENGAGED_TIMEOUT_S=180        # …and the drift down the cost ladder
MIND_IDLE_TIMEOUT_S=3600
MIND_DREAM_START_HOUR=2           # local window DORMANT may enter DREAM
MIND_DREAM_END_HOUR=6

# body reflexes + the murmur (§15.5 — the old idle machine's windows, kept)
IDLE_SETTLE_S=20                  # quiet time after a turn before ambient life resumes
IDLE_ACT_MIN_S=8                  # reflex window (gaze drift, expression pulse…)
IDLE_ACT_MAX_S=25
IDLE_TALK_MIN_S=120               # the self-talk impulse: one short spoken
IDLE_TALK_MAX_S=300               #   in-character line after this much quiet

# --- channels: the mediums beyond this origin (SPEC §10.5) ----------------------
# A channel is on when its credentials are set. Telegram: make a bot with
# @BotFather, paste its token; leave TELEGRAM_CHAT_ID empty for the first run,
# message the bot once, and it replies with the id to paste here (pairing mode —
# she binds to exactly one chat, and strangers are ignored).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
TELEGRAM_SEND_NON_TELEGRAM=false  # Telegram replies stay in Telegram; opt in to cross-chat copies
# One bot, one character. Telegram's getUpdates is exclusive per token, so two
# characters on one bot would fight over its updates forever — each gets her own
# @BotFather bot, named with her registry id (the dashboard's card URL: mia,
# yuri, …) upper-cased. These are hers alone and never shared — and the gear in
# her own room edits exactly this pair, if you'd rather not do it by hand:
#TELEGRAM_BOT_TOKEN_MIA=
#TELEGRAM_CHAT_ID_MIA=
# The unsuffixed pair above stays the single-companion install's. Once there are
# others, say who keeps it — otherwise it is offered to every character without
# her own bot and the first one to start holds it (the rest report the medium as
# "held by <her>", which is healthy, not failed). A character with neither pair
# is simply not on Telegram.
#TELEGRAM_CHARACTER=yuri
# The terminal channel needs no config: `python -m yurios.chat` against a
# running server. WhatsApp + a game-engine NPC API are planned on the same seam.

# --- the room (SPEC §6) --------------------------------------------------------
RAIN_INTENSITY=0.6                # 0..1; she can't change the weather, but you can

# --- the desktop window (`python -m yurios.world --window`, SPEC §6.5–§6.6) -----
# The room set aside: a frameless, transparent, always-on-top native window with
# just her in it (needs the [desktop] extra). The frame knobs are the vendored
# B2 §9 set; DESKTOP_BODY picks which body floats in it.
DESKTOP_BODY=vrm                  # vrm (the 3D stage) | live2d (the vendored B2 client)
#AVATAR_MODEL=hiyori              # which Live2D rig, if live2d (fetch: scripts/fetch_live2d.py)
WINDOW_WIDTH=360
WINDOW_HEIGHT=640
WINDOW_ON_TOP=true
#WINDOW_GUI=gtk                   # engine override: "" auto (Chromium if installed — crisper) | qt | gtk

# --- what leaves the machine (SPEC §3) -----------------------------------------
# Not knobs on her — knobs on two LIBRARIES that reach the network on nothing but
# an `import`, and read these from the environment at that moment. YuriOS applies
# the quiet setting itself (yurios/__init__.py) because a typed config field would
# arrive too late; they are listed here so they're visible, and so uncommenting one
# takes it back. Neither disables anything of hers. `python -m yurios.doctor`
# prints what this section (and your model choices) add up to on the wire.
#LITELLM_LOCAL_MODEL_COST_MAP=True # False re-enables the 1.67 MB price map that
                                   # `import litellm` GETs from raw.githubusercontent
                                   # .com on every start. Nothing here reads it, and
                                   # litellm ships the same file in the wheel.
#HF_HUB_DISABLE_TELEMETRY=1        # 0 lets Hugging Face model downloads (kokoro,
                                   # faster-whisper; once per model) report your
                                   # torch build and which AI harness is running.

# With the local defaults above, nothing needs a cloud key — pull the network
# cable and she still runs (get_weather degrades gracefully; everything else is
# on-device).
