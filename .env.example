# Build #5 config (SPEC §11 + §25). Copy to .env. Every knob has a default in
# world/config.py (which extends Build #2's desktop/config.py, which extends the
# Build #1 brain's app/config.py); this file shows the ones you'll actually touch.

# --- the brain (Build #1, reused) — see Build #2's .env.example for the full story
# The model id's PREFIX picks the provider: gguf/… | lm_studio/… | ollama/… |
# openrouter/… . The direct gguf/ route downloads its Q4_K_M GGUF from Hugging
# Face, proves its llama.cpp options in a sacrificial process, then runs the
# passing configuration in-process. It never needs LM Studio.
# An uncensored model on purpose — she's a companion, not an assistant, and a
# refusal-trained model plays her badly. Any LiteLLM route works instead.
#
# This is the HOUSE DEFAULT: every character inherits it unless her own record
# says otherwise. NONE deliberately makes no LLM connection. On first web load,
# or with `yurios configure`, choose a model; a gguf/ choice is downloaded on
# demand. The top panel of the gear can still give one character her own model.
CHAT_MODEL=NONE
UTILITY_MODEL=NONE
# The default Hugging Face choice resolves
# Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf. GGUF_REPO only
# overrides the repository when a serving/model id cannot name it directly.
GGUF_REPO=
GGUF_QUANT=Q4_K_M
GGUF_CACHE_DIR=./models
GGUF_CONTEXT_LENGTH=0              # 0 = CONTEXT_LENGTH, otherwise 8192; preflight can fall back to 8192
GGUF_N_GPU_LAYERS=0                # CPU wheel by default; partial GPU offload falls back to full GPU/CPU
GGUF_N_THREADS=0                   # llama.cpp chooses automatically
GGUF_FLASH_ATTN=true               # efficient long-context KV cache; required for Gemma 4
# The context window she runs in, in tokens. The direct GGUF provider passes this
# to llama.cpp unless GGUF_CONTEXT_LENGTH overrides it. Bigger costs RAM/VRAM for
# the KV cache — 8192 is a floor, 32768 is comfortable; your machine decides.
CONTEXT_LENGTH=32768
# Local Ollama server — routes ollama/… model ids and lets the settings panel
# list the models you've pulled.
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# Real-time voice: reply <think> OFF, utility <think> ON (B2 §2.5–§2.6).
CHAT_THINKING=false
UTILITY_THINKING=true
UTILITY_MAX_TOKENS=10048

# Embeddings stay local (B2 §2.4). Default: sentence_tf runs IN-PROCESS through the
# sentence-transformers package installed with YuriOS (weights pulled from HuggingFace
# once), so memory works without LM Studio or Ollama. To share LM Studio with the chat
# model instead, set EMBED_BACKEND=lm_studio, EMBED_MODEL=text-embedding-nomic-embed-
# text-v1.5, and EMBED_DIM=768. `ollama` is another local-server option.
#
# EMBED_MODEL and EMBED_DIM must match the backend (a mismatch fails at reindex).
# Changing any of the three re-indexes the Vault from its .md files automatically
# (fingerprint check, §2.4) — safe to switch later, it just costs one reindex.
EMBED_BACKEND=sentence_tf
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Her own Vault (standalone). Seed once: `python scripts/seed_vault.py`. Point at a
# Build #1/#2 Vault to *continue* that companion (SPEC §2.4) — she is the folder.
VAULT_DIR=./vault
SOUL_SRC=./soul-src
# YuriOS 0.2 copies the legacy roots above into a character-scoped data tree on
# first normal startup. The source directories remain untouched as a backup.
DATA_DIR=./data
UTILITY_ENABLED=true
DREAM_ENABLED=true

HOST=127.0.0.1                    # 127.0.0.1 = local only; 0.0.0.0 = every interface
PORT=8768
# Required when HOST is not loopback, and at least 32 characters. Do not type one
# here: `yurios pair` generates it, writes it, applies it to the running server
# and prints a QR code that signs a phone in by scanning — as does the button
# beside this field in House settings (the switchboard) or the gear in her room.
# Rotating it signs every other device out, which is also how you evict one.
# Use Tailscale/SSH or an authenticated TLS reverse proxy outside a trusted LAN.
OWNER_TOKEN=

# --- voice (vendored Build #2 stack; see its .env.example for every knob) -----
# `./install.sh` installs all three of these by default (CPU-only, no CUDA), so this
# file works as shipped. `./install.sh --thin` skips them and, for a newly created
# .env, sets the three knobs below to `fake` — she boots either way, a fake seam is
# just silent. Existing .env files are preserved.
STT_BACKEND=faster_whisper        # faster_whisper | fake
STT_MODEL=base.en
TTS_BACKEND=kokoro                # kokoro (default, CPU) | qwen3_tts | gpt_sovits | fake
VAD_BACKEND=silero                # silero | fake
MASK_LATENCY=true
MAX_REPLY_TOKENS=1600
# Her voice loads when someone enters one of her rooms (opens /ws/voice) and is freed
# when the last of them leaves, so a node hosting several characters keeps one voice
# resident instead of one per character. The grace period below covers a page reload.
VOICE_PRELOAD=false               # true = warm at boot instead (single-companion installs)
VOICE_UNLOAD_AFTER_S=60           # empty-room grace, seconds; 0 = at once, -1 = never unload

# --- the hands: tools over MCP (SPEC §7) --------------------------------------
# mcp = real in-repo MCP server over stdio (the default; needs the `mcp` package,
# installed with the build). fake = deterministic offline results. off = no hands.
TOOLS_BACKEND=mcp                 # mcp | fake | off
TOOL_MAX_CALLS_PER_TURN=2         # per-turn cap (§7.3)
TOOL_TIMEOUT_S=10                 # per-call timeout
TOOL_LOG_DIR=./tool-logs          # one JSONL audit line per call, allowed or denied
# Per-tool rate limits, calls per minute (token bucket, §7.3):
TOOL_RATE_TIMER=6
TOOL_RATE_MUSIC=6
TOOL_RATE_DESK=20                 # her workspace + skills hands (§34.2)
                                  #   Generous, because these are local writes
                                  #   with no cost and no outside party — the
                                  #   bucket catches a loop, not a user
TIMER_MAX_MINUTES=180             # set_timer upper bound (§7.1)

# The web (§7.7): web_search (find it), read_page (read it), research (go and
# find out about it properly, in the background). Everything she reads is
# shelved in her knowledge store — chunked, embedded, and citable later — so a
# page she read stays read instead of expiring with the turn.
#
# searxng = your own SearXNG instance: keyless AND third-party-less, which is
# the local-first argument applied to the one capability that usually hands
# your curiosity to somebody else. fake = deterministic offline rows. off = no
# web hands at all (the default: the instance is a service you stand up first,
# and a hand that always errors is worse than one she doesn't have).
#
# Don't set this up by hand — the installer does it, container and all:
#
#     ./install.sh --web-search
#
# It then starts with `yurios start`, and `yurios doctor` tells you whether she
# can actually search right now. Edit the instance itself (engines, safesearch)
# in data/searxng/settings.yml.
#
# ⚠ If you point this at an instance you already run: SearXNG ships with its
# JSON output DISABLED, and the symptom is a 403 on every query — which reads
# like an auth problem and isn't. Add `json` to `search.formats` in its
# settings.yml and restart it. Check with:
#
#     curl 'http://localhost:8080/search?q=test&format=json'
#
SEARCH_BACKEND=off                # searxng | fake | off
SEARXNG_URL=http://localhost:8080
SEARCH_RESULTS=5                  # rows per web_search
SEARCH_LANGUAGE=en
SEARCH_SAFESEARCH=1               # 0 none | 1 moderate | 2 strict
FETCH_TIMEOUT_S=8                 # one page, kept inside TOOL_TIMEOUT_S
FETCH_MAX_BYTES=2000000           # read_page stops here
RESEARCH_MAX_PAGES=5              # ceiling and omitted-depth default for research
TOOL_RATE_SEARCH=6
TOOL_RATE_READ=6
TOOL_RATE_RESEARCH=2              # a run is many requests behind one call

# Other people's hands: third-party MCP servers (§7.2). A JSON file in the
# familiar {"mcpServers": {...}} shape, so a server config you already have
# pastes straight in. Unset = her own in-repo server alone. Mounting a server
# gives her its tools, rate-limited but not reviewed — a per-server "rate" key
# in the file tightens the bucket.
# MCP_SERVERS=./mcp-servers.json
TOOL_RATE_EXTERNAL=4              # default bucket for a discovered tool

# Pictures *in* (§35) — the mirror of her camera below: what YOU can send HER.
# The composer grows a paperclip (and Telegram starts accepting photos) only when
# the model behind CHAT_MODEL takes image parts as well as text. `auto` asks the
# provider itself at boot — LM Studio, Ollama and OpenRouter each publish it, and
# the answer shows in /api/health as image_input. `on`/`off` override that, for
# the case the probe gets it wrong; `off` also means POST /api/uploads is refused.
CHAT_IMAGE_INPUT=auto             # auto | on | off
UPLOAD_DIR=./uploads              # what you sent her (/api/uploads/<name>)
# Every sent picture is re-encoded before she sees it: the long side is capped
# here, EXIF orientation is applied and the rest of the metadata is dropped. This
# is a context-window knob as much as a bandwidth one — an image is worth a
# four-figure number of tokens, and 1024 is about the smallest that still reads
# handwriting.
CHAT_IMAGE_MAX_PX=1024
UPLOAD_MAX_BYTES=12000000         # what the route accepts, before the re-encode
UPLOAD_KEEP=200                   # newest N kept; older ones pruned on save

# Her camera (§7.6): take_selfie (a photo of her) and show_picture (a photo of
# anything else — the street, a sketch, whatever she's describing) both render
# through the vendored forge (./forge).
# openrouter = hosted (needs OPENROUTER_API_KEY above; GPU stays free for her
# voice). diffusers = a local SDXL checkpoint on your own GPU (below). mock =
# placeholder cards, keyless. off = no camera. No key with openrouter set? She
# degrades to mock with one loud WARNING. New installs leave her camera off;
# configure it with `yurios configure --selfie-backend ...`.
SELFIE_BACKEND=off                # openrouter | diffusers | mock | off
SELFIE_MODEL=bytedance-seed/seedream-4.5
SELFIE_DIR=./selfies              # saved shots + their provenance ledger (/selfies/)
# Optional overlay yaml merged over the shipped selfie template library —
# your own scenes/moods/tiers, a file outside the repo like the checkpoint.
# SELFIE_TEMPLATES_EXTRA=./data/characters/yuri/selfie-extra.yaml
# A library that REPLACES the shipped one instead of merging over it. Normally
# you don't set this: a character runtime points it at her own selfie.yaml,
# which the card studio writes (Selfies section) — the overlay above still
# layers on top of whichever base wins.
# SELFIE_TEMPLATES=./data/characters/yuri/selfie.yaml
TOOL_RATE_SELFIE=2                # calls/minute — images are expensive
TOOL_RATE_PICTURE=2               # show_picture gets its own budget, not a share

# SELFIE_BACKEND=diffusers — her own camera, on your own GPU, no third party.
# The model is loaded IN-PROCESS with diffusers (no A1111/ComfyUI to install):
#
#   1. pip install -e ".[forge-local]"     # + torch with CUDA (the PyPI default)
#   2. Download an Illustrious-lineage SDXL checkpoint (.safetensors) from
#      Civitai — the reference pick is a Pie Model:
#        https://civitai.com/models/1593793/pie-models
#      (one base per aesthetic — Lemon = general anime, Nutella = sharp linework,
#      Blueberry = semi-realistic; any Illustrious-family base works, and swapping
#      models later is swapping this one path). ~7 GB; a free Civitai account may
#      be required; the model's own license applies. LoRA is NOT wired in this
#      build — base checkpoint only.
#   3. Point SELFIE_LOCAL_MODEL at the file and set SELFIE_BACKEND=diffusers.
#
# The shipped yuri.yaml already carries the booru-style quality preamble these
# bases expect — prompts need no changes. The defaults below are the Pie
# author's own (DPM++ 2M / Karras / 30 steps / CFG 5 / hires fix on). VRAM:
# ~7 GB fp16 next to your LLM's ~6.7 GB fits a 16 GB card; set
# SELFIE_LOCAL_CPU_OFFLOAD=true if you need the headroom (renders ~2× slower).
# path to the .safetensors checkpoint. No trailing comment: an empty value
# followed by `#` is parsed as the comment text, and a checkpoint path of prose
# fails at load with a message about a file nobody named.
SELFIE_LOCAL_MODEL=
SELFIE_LOCAL_DEVICE=cuda
SELFIE_LOCAL_STEPS=30
SELFIE_LOCAL_CFG=5.0
SELFIE_LOCAL_HIRES=true           # upscale 1.5x + low-denoise img2img pass
SELFIE_LOCAL_HIRES_SCALE=1.5
SELFIE_LOCAL_HIRES_DENOISE=0.35
SELFIE_LOCAL_CPU_OFFLOAD=false
# The HIRES_* knobs above are SDXL's second pass; Krea 2 renders at size in one.
#
# Krea 2 checkpoints: same knob, different architecture. If SELFIE_LOCAL_MODEL
# is a Krea 2 export rather than SDXL, SELFIE_BACKEND=diffusers notices (it
# reads the file's header) and loads it through the krea2 backend instead —
# nothing here to change. SELFIE_BACKEND=krea2 forces it, for a file whose
# header doesn't say. That path needs two extra things:
#
#   1. pip install -e ".[forge-krea2]"    # adds comfy-kitchen
#   2. HF access to the text encoder + VAE, which these single-file checkpoints
#      don't carry: accept the licence at https://huggingface.co/krea/Krea-2-Raw
#      while signed in, then `huggingface-cli login` (or set HF_TOKEN). Fetched
#      once and cached; its own transformer weights are skipped — yours replace
#      them. Without this she degrades to placeholder cards and says so.
#
# The weights are never dequantized: a Krea 2 transformer is ~12.5 B parameters
# (~23 GB at bf16, which fits nothing), so the INT4 file is run as-is at ~6.4 GB
# resident — smaller AND faster than unpacking it. Sampling differs from SDXL's,
# so it gets its own two knobs; 0 / -1 mean "read it off the checkpoint" —
# 8 steps at guidance 0.0 for a turbo/TDM export, 28 at 4.5 for a base one.
# Set them only to override that.
SELFIE_KREA2_STEPS=0
SELFIE_KREA2_CFG=-1
# VRAM lending: when a render is requested and the free VRAM won't hold the
# resident pipeline (~11 GiB) next to your LLM, the LLM is PARKED — unloaded
# for the render's duration, then brought back (the render drops from a ~70s
# offload crawl to ~15s resident). Works for LM Studio models (evicted over
# its API) and for the direct gguf/ route (llama.cpp contexts closed in-process
# and reloaded). Her brain always comes back, even if a render fails. Set false
# to never touch the LLM (renders use offload instead).
SELFIE_LLM_PARK=true
# Room her brain needs on the card after a render (GiB). The camera keeps its
# pipeline warm between renders — worth ~25 s a selfie — but only while this
# much VRAM is still free with the pipeline loaded. Otherwise her brain reloads
# beside it, the card fills, and the *next* render OOMs. Raise it if your chat
# model is bigger than ~6 GiB on the card.
SELFIE_WARM_HEADROOM_GIB=6.0

# --- the shelf: drop-folder RAG, and how much of it reaches a turn (§20) ----------
# Everything on the shelf goes through one slot: files you drop in
# vault/knowledge/reference/, pages from `read_page`, and whatever `research`
# brings home. Each turn searches it and puts the best chunks in the prompt with
# their `doc (chars a-b)` citations. Keep K small — a chunk is a paragraph, not a
# line — and note it is the first block dropped when the prompt overflows.
KNOWLEDGE_K=3                     # chunks injected per turn; 0 = slot off (archive only)
KNOWLEDGE_MIN_SCORE=0.05          # hybrid-score floor, below which a chunk is noise
KNOWLEDGE_BUDGET_TOKENS=900       # ceiling on the block itself

# --- the mind: the always-on tick loop (SPEC §15–§18) -----------------------------
MIND_ENABLED=true                 # off = Build #4 behaviour, minus the ambient life
MIND_SEED=0                       # 0 = unseeded; tests pin a seed for determinism
MIND_ACT_THRESHOLD=0.4            # gate 1: salience-to-act (most ticks REST below it)
MIND_INTERRUPT_THRESHOLD=0.75     # gate 2: salience-to-interrupt — YOUR dial (§18.2)
MIND_MAX_INTERRUPTS_PER_DAY=3     # the hard daily cap on her reaching out first
MIND_DAILY_TOKENS=200000          # the budget governor's cap (§17.3)
MIND_DREAM_TICK_TOKENS=40000      # per-DREAM-tick consolidation budget (§21)
MIND_DREAM_RESEARCH_TOKENS=120000 # the research lane's own budget (§21.2)
                                  #   A night of reading the web is an order of
                                  #   magnitude past a diary entry, so it is
                                  #   billed separately or it eats the roster.
# The three below are the house ceilings on one research job's night. A job file
# may ask for LESS than these and never for more, and they have to be spendable
# together: pages is what the corpus can hold, and steps has to cover the
# searches AND the pages AND the thinking in between, or the night always ends
# mid-gather instead of on purpose.
MIND_DREAM_RESEARCH_SEARCHES=8    # searches one research night may run
MIND_DREAM_RESEARCH_PAGES=6       # pages it may read into the corpus
MIND_DREAM_RESEARCH_STEPS=16      # steps across the searches, the pages and the thinking
MIND_ENGAGED_CADENCE_S=10         # tick cadence per activity state (§17.1)
MIND_IDLE_CADENCE_S=60
MIND_DORMANT_CADENCE_S=900
MIND_DREAM_CADENCE_S=120
MIND_ENGAGED_TIMEOUT_S=180        # quiet before she drifts down the cost ladder
MIND_IDLE_TIMEOUT_S=3600
MIND_DREAM_START_HOUR=2           # local window DORMANT may enter DREAM
MIND_DREAM_END_HOUR=6
MIND_CONSIDER_COOLDOWN_S=3600     # min gap before one goal is re-chewed
GOALS_IN_PROMPT=12                # newest N open goals in every turn's prompt
                                  #   (§22.6). 0 = the block is off — but off
                                  #   means she talks with no idea what she is
                                  #   already working on, and re-promises it
MIND_GOAL_MAX_STEPS=3             # working ticks one goal gets before it waits
                                  #   or the commitment strategy lets it go
MIND_DISPATCH_TIMEOUT_S=3600      # how long a goal waits on work it dispatched
                                  #   before the loop wakes it anyway
# DREAM is a pipeline of jobs, not one job (§21.2): consolidate, then diary,
# then strategy, then the selfie dream — highest priority first, sharing
# MIND_DREAM_TICK_TOKENS above. The selfie job is out of the night entirely when
# SELFIE_BACKEND=off. There is no per-job switch here on purpose: the roster is
# HERS, one file per job in `vault/dreams/`, and the mind debug page's Dreams
# section edits them, runs any one against any day you like, dry, and shows you
# the prompt it sent.
#
# A job file is YAML frontmatter over a body that IS the system prompt. `kind:`
# picks what sort of night it is — `prompt` (read the day's journal, answer the
# question, write it to her desk) or `research` (search the web, read what she
# finds, write a report). A research job can put that report where you will see
# it next time you open her chat with `deliver: chat`. `standing: true` makes a
# job run every night whether or not you spoke to her, which is what anything
# looking at the world rather than at the conversation needs.

# --- her desk and her skills (SPEC §34) -------------------------------------------
# `vault/workspace/` is hers to read and write freely through her own tools —
# notes, drafts, research scratch, the middle of a thought. `vault/skills/` is
# the same primitive pointed at instructions: one folder per skill, each with a
# SKILL.md whose `description` says WHEN to reach for it. Every turn carries the
# skill catalog and a listing of the desk (names only, a line each); the bodies
# load on demand through `read_skill` / `read_note`.
#
# Both live inside the Vault and travel with her, but only skills are versioned:
# scratch churns, and her git log is the diary of how she grew, not of every
# draft she rewrote (workspace/.gitignore carries that rule). The
# coming code harness gets its own workspace *outside* the Vault — "she can
# write here" and "this can run" must never be the same sentence.
WORKSPACE_ENABLED=true            # off = no desk tools and no desk block
WORKSPACE_DIGEST_FILES=20         # newest N desk files named in the prompt
SKILLS_ENABLED=true               # off = no skill tools and no catalog block

# --- her hands in the loop: tools she reaches for unasked (SPEC §26) --------------
# Everything above this line is a hand she uses *while talking to you*. This is
# the other thing: her own goals, worked between conversations, reaching for a
# tool at four in the morning with nobody in the room.
#
# IT IS OFF, AND IT STAYS OFF UNTIL YOU MAKE TWO SEPARATE DECISIONS. The switch
# below turns the capability on for this machine; the allowlist after it says
# which hands, by name, and it is empty even once the switch is true. There is
# no wildcard and nothing is inherited from her conversational hands. Off means
# the tools are not described to her at all — she cannot call what she cannot
# see. Each character then has her own `hands` toggle on the switchboard, in
# series with this one: the house decides whether anyone may, she decides who.
#
# Three rules hold whatever you set here, and they are worth knowing before you
# set anything:
#   * A call is always a step of an open goal in `vault/goals.md`, never
#     free-floating, and at most one per tick. That file is therefore the whole
#     readable list of what her hands might do.
#   * Whatever a hand produces lands in the VAULT — the shelf, the gallery, her
#     desk — and posts nothing. Whether you ever hear about it is Gate 2's
#     decision on a later tick, the same gate that governs her reaching out.
#   * Every call, allowed or denied, is one line in tool-logs/calls.jsonl marked
#     `mind_tool`. "What did she do at 4am" is a file you read.
MIND_TOOLS_ENABLED=false          # the house switch (§26.1)
# MIND_TOOL_ALLOWLIST — explicit names, comma-separated. Empty = off.
#   Cheap (a step in goal work, allowed unless she is mid-conversation):
#     write_note, append_note, edit_note, delete_note, read_note, list_notes,
#     count_note_lines, read_skill, write_skill, set_timer
#   Expensive (a whole tick's intention; needs its backend on, the budget under
#   the ceiling, and an empty room):
#     research, read_page, web_search, take_selfie, show_picture
#   A gentle first setting is the desk alone:
#     MIND_TOOL_ALLOWLIST=write_note,append_note,read_note,list_notes
# (No trailing comment on this line: an EMPTY value followed by `#` is read as
# the comment text, and an allowlist of prose is not the default anyone wanted.)
MIND_TOOL_ALLOWLIST=
MIND_TOOL_CALLS_PER_DAY=8         # a CAP, not a governor: past it, the call is refused
                                  #   Rolls at local midnight, beside the
                                  #   interrupt cap.
MIND_TOOL_PRESSURE_CEILING=0.5    # budget pressure that makes the expensive class unavailable
                                  #   A precondition here, unlike
                                  #   MIND_DAILY_TOKENS.
# How long the SAME call (same tool, same arguments) is refused. Persistent
# across restarts, and never shorter than MIND_CONSIDER_COOLDOWN_S — or the goal
# comes back round and she does the identical thing again.
MIND_TOOL_COOLDOWN_CHEAP_S=21600
MIND_TOOL_COOLDOWN_EXPENSIVE_S=172800
# …and the per-tool override: "web_search=3600,research=604800". Empty, so no
# trailing comment (see MIND_TOOL_ALLOWLIST above).
MIND_TOOL_COOLDOWN_S=
# Her own token buckets, calls per minute, separate from the conversation's — a
# night of autonomous work must never leave your morning request rate-limited,
# or the reverse.
TOOL_RATE_MIND_DESK=4             # her desk and her skills, working alone
TOOL_RATE_MIND_WEB=1              # search, read and research
TOOL_RATE_MIND_CAMERA=1           # her camera
TOOL_RATE_MIND_OTHER=1            # everything else she reaches for unasked

# --- the self-edit door (SPEC §23) ------------------------------------------------
# `propose_edit` lets her ask to change one of her own soul files — PERSONA,
# NOTES, SCENARIO, EXAMPLES, WORLD. Nothing takes effect on the call: the
# proposal is queued with its full text and her reason, and the inner-life panel
# is where you approve or reject it. Her CONSTITUTION is not on the list and
# never will be — she can read every limit she runs under, and she does not hold
# the pen that rewrites them. Advertised only where the mind is running.
TOOL_RATE_SELFEDIT=1              # propose_edit per minute — deliberation, not a loop

# body reflexes + the murmur (§15.5 — the old idle machine's windows, kept)
IDLE_SETTLE_S=20                  # quiet time after a turn before ambient life resumes
IDLE_ACT_MIN_S=8                  # soonest a reflex fires (gaze drift, expression pulse…)
IDLE_ACT_MAX_S=25                 # latest a reflex fires
# The self-talk impulse: one short spoken in-character line after this much quiet.
IDLE_TALK_MIN_S=120               # soonest she murmurs to herself
IDLE_TALK_MAX_S=300               # latest she murmurs to herself

# --- the tray icon (SPEC §18.4.7) ----------------------------------------------
# The house from the corner of the screen: one icon, a tooltip naming who is
# waiting, and a right-click menu that opens her room. ON by default — it is a
# thing you look at, not a thing that interrupts you, it reads the daemon
# in-process so it never reads as you being in the room, and where there is no
# tray (headless, ssh, a desktop with no host) it simply never appears.
#
# GNOME removed the system tray in 2017: install.sh installs the AppIndicator
# shell extension for you, but gnome-shell only reads extensions at session
# start, so on a first install the icon arrives at your next login.
TRAY_ENABLED=true

# --- channels: the mediums beyond this origin (SPEC §10.5) ----------------------
# A channel is on when its credentials are set. Telegram: make a bot with
# @BotFather, paste its token; leave TELEGRAM_CHAT_ID empty for the first run,
# message the bot once, and it replies with the id to paste here (pairing mode —
# she binds to exactly one chat, and strangers are ignored).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
TELEGRAM_SEND_NON_TELEGRAM=false  # Telegram replies stay in Telegram; opt in to cross-chat copies
# One bot, one character. Telegram's getUpdates is exclusive per token, so two
# characters on one bot would fight over its updates forever — each gets her own
# @BotFather bot, named with her registry id (the dashboard's card URL: mia,
# yuri, …) upper-cased. These are hers alone and never shared — and the gear in
# her own room edits exactly this pair, if you'd rather not do it by hand:
#TELEGRAM_BOT_TOKEN_MIA=
#TELEGRAM_CHAT_ID_MIA=
# The unsuffixed pair above stays the single-companion install's. Once there are
# others, say who keeps it — otherwise it is offered to every character without
# her own bot and the first one to start holds it (the rest report the medium as
# "held by <her>", which is healthy, not failed). A character with neither pair
# is simply not on Telegram.
#TELEGRAM_CHARACTER=yuri
# The terminal channel needs no config: `python -m yurios.chat` against a
# running server. WhatsApp + a game-engine NPC API are planned on the same seam.

# --- the room (SPEC §6) --------------------------------------------------------
RAIN_INTENSITY=0.6                # 0..1; she can't change the weather, but you can

# --- the desktop window (`python -m yurios.world --window`, SPEC §6.5–§6.6) -----
# The room set aside: a frameless, transparent, always-on-top native window with
# just her in it (needs the [desktop] extra). The frame knobs are the vendored
# B2 §9 set; DESKTOP_BODY picks which body floats in it.
DESKTOP_BODY=vrm                  # vrm (the 3D stage) | live2d (the vendored B2 client)
#AVATAR_MODEL=hiyori              # which Live2D rig, if live2d (fetch: scripts/fetch_live2d.py)
WINDOW_WIDTH=360
WINDOW_HEIGHT=640
WINDOW_ON_TOP=true
#WINDOW_GUI=gtk                   # engine override: "" auto (Chromium if installed — crisper) | qt | gtk

# --- what leaves the machine (SPEC §3) -----------------------------------------
# Not knobs on her — knobs on two LIBRARIES that reach the network on nothing but
# an `import`, and read these from the environment at that moment. YuriOS applies
# the quiet setting itself (yurios/__init__.py) because a typed config field would
# arrive too late; they are listed here so they're visible, and so uncommenting one
# takes it back. Neither disables anything of hers. `python -m yurios.doctor`
# prints what this section (and your model choices) add up to on the wire.
#LITELLM_LOCAL_MODEL_COST_MAP=True # False re-enables the 1.67 MB price map that
                                   # `import litellm` GETs from raw.githubusercontent
                                   # .com on every start. Nothing here reads it, and
                                   # litellm ships the same file in the wheel.
#HF_HUB_DISABLE_TELEMETRY=1        # 0 lets Hugging Face model downloads (kokoro,
                                   # faster-whisper; once per model) report your
                                   # torch build and which AI harness is running.

# With the local defaults above, nothing needs a cloud key — pull the network
# cable and she still runs (the web hands degrade gracefully; everything else is
# on-device).
